# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/attendance_system

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Attendance rules
DEFAULTER_THRESHOLD_PERCENT=75
# QR tokens rotate on the faculty screen. Keep the validity window slightly longer than the poll interval.
QR_TOKEN_VALID_SECONDS=10
QR_ROTATION_INTERVAL_SECONDS=10
QR_TOKEN_GRACE_SECONDS=5
# A batch's classroom may use this fallback radius when a radius is not explicitly saved.
GEOFENCE_DEFAULT_RADIUS_METERS=75
GEOFENCE_MAX_ACCURACY_METERS=100

# Email (Resend HTTPS API)
# Create an API key at https://resend.com and verify a sender domain/email
RESEND_API_KEY=your_resend_api_key
MAIL_FROM="Attendance System <onboarding@resend.dev>"

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

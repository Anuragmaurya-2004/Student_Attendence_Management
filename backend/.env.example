# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/attendance_system

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Attendance rules
DEFAULTER_THRESHOLD_PERCENT=75
QR_TOKEN_VALID_MINUTES=10

# Email (Nodemailer) - use Gmail App Password or any SMTP provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="Attendance System <your_email@gmail.com>"

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
